+/// Insert every key of `extra` that `body` lacks, recursing into objects
+/// present in both. Keys the request already sets always win, so config can
+/// add fields but never change what the provider computed.
+fn merge_missing(body: &mut serde_json::Map<String, serde_json::Value>, extra: &serde_json::Map<String, serde_json::Value>) {
+    for (key, value) in extra {
+        match body.get_mut(key) {
+            None => {
+                body.insert(key.clone(), value.clone());
+            }
+            Some(serde_json::Value::Object(existing)) => {
+                if let serde_json::Value::Object(extra_obj) = value {
+                    merge_missing(existing, extra_obj);
+                }
+            }
+            Some(_) => {}
+        }
+    }
+}
